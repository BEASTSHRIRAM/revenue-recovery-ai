# ============================================================
#  Revenue Recovery AI — environment template
#  Copy to .env and fill in what you have. Every key is
#  optional: missing keys degrade to a safe local mode.
# ============================================================

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Secret used to sign customer "update payment method" links
LINK_SIGNING_SECRET=change-me-in-production
PUBLIC_APP_URL=http://localhost:3000

# ---------- Database ----------
# SQLite by default (zero setup). Swap for Postgres in one line:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recovery
DATABASE_URL=sqlite+aiosqlite:///./recovery.db
# LangGraph checkpointer store (per-case agent state)
CHECKPOINT_DB=./checkpoints.sqlite

# ---------- Groq (the agent brain) ----------
# Get one at https://console.groq.com — without it the agent runs in
# deterministic stub mode so the platform still works end to end.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_RETRIES=2
GROQ_TIMEOUT_SECONDS=60

# ---------- Razorpay ----------
# Without these the mock payment provider drives seeded demo data.
PAYMENT_PROVIDER=mock            # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (real sends) ----------
EMAIL_CHANNEL=simulated          # simulated | resend | smtp
EMAIL_FROM="Billing <billing@example.com>"
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---------- Outreach safety rails ----------
# Hard caps the agent cannot talk its way past.
MAX_MESSAGES_PER_CUSTOMER_PER_WEEK=3
MAX_RETRIES_PER_CASE=4
REQUIRE_HUMAN_APPROVAL=false

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
